generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccessLevel {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id                    String           @id @default(uuid())
  name                  String
  timezone              String           @default("Europe/Berlin")
  defaultWeeklyLimitMin Int              @default(2400) @map("default_weekly_limit_min")
  minRestMin            Int              @default(660) @map("min_rest_min")
  maxDailyMin           Int              @default(600) @map("max_daily_min")
  offerLeadTimeMin      Int              @default(120) @map("offer_lead_time_min")
  createdAt             DateTime         @default(now()) @map("created_at")
  memberships           Membership[]
  skills                Skill[]
  shifts                Shift[]
  unavailabilities      Unavailability[]
  offers                Offer[]
  acceptances           Acceptance[]
  auditLogs             AuditLog[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String?          @map("user_id")
  user           User?            @relation(fields: [userId], references: [id])
  displayName    String           @map("display_name")
  email          String?
  accessLevel    AccessLevel      @map("access_level")
  status         MembershipStatus @default(ACTIVE)
  weeklyLimitMin Int?             @map("weekly_limit_min")
  externalId     String?          @map("external_id")
  source         String           @default("MANUAL")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  skills              MembershipSkill[]
  assignedShifts      Shift[]           @relation("ShiftAssignee")
  unavailabilities    Unavailability[]
  originalOwnerOffers Offer[]           @relation("OfferOriginalOwner")
  createdOffers       Offer[]           @relation("OfferCreator")
  resolvedOffers      Offer[]           @relation("OfferResolver")
  acceptances         Acceptance[]
  auditLogs           AuditLog[]

  @@unique([organizationId, userId])
  @@unique([organizationId, externalId])
  @@map("memberships")
}

enum OfferKind {
  GIVE_AWAY
  OPEN_SHIFT
}

enum OfferStatus {
  OPEN
  APPROVED
  REJECTED
  FILLED
  CANCELLED
  EXPIRED
}

enum AcceptanceStatus {
  PENDING
  SELECTED
  NOT_SELECTED
  WITHDRAWN
  INVALIDATED
}

model Skill {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  members        MembershipSkill[]
  shifts         ShiftSkill[]

  @@unique([organizationId, name])
  @@map("skills")
}

model MembershipSkill {
  membershipId String     @map("membership_id")
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  skillId      String     @map("skill_id")
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([membershipId, skillId])
  @@map("membership_skills")
}

model Shift {
  id                   String       @id @default(uuid())
  organizationId       String       @map("organization_id")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  startAt              DateTime     @map("start_at")
  endAt                DateTime     @map("end_at")
  assignedMembershipId String?      @map("assigned_membership_id")
  assignedMembership   Membership?  @relation("ShiftAssignee", fields: [assignedMembershipId], references: [id], onDelete: Restrict)
  location             String?
  notes                String?
  externalId           String?      @map("external_id")
  source               String       @default("MANUAL")
  version              Int          @default(1)
  deletedAt            DateTime?    @map("deleted_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  skills               ShiftSkill[]
  offers               Offer[]

  @@unique([organizationId, externalId])
  @@index([organizationId, startAt])
  @@index([assignedMembershipId, startAt])
  @@map("shifts")
}

model ShiftSkill {
  shiftId String @map("shift_id")
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  skillId String @map("skill_id")
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([shiftId, skillId])
  @@map("shift_skills")
}

model Unavailability {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membershipId   String       @map("membership_id")
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  startAt        DateTime     @map("start_at")
  endAt          DateTime     @map("end_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([membershipId, startAt])
  @@map("unavailabilities")
}

model Offer {
  id                        String       @id @default(uuid())
  organizationId            String       @map("organization_id")
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  shiftId                   String       @map("shift_id")
  shift                     Shift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  kind                      OfferKind
  status                    OfferStatus  @default(OPEN)
  originalOwnerMembershipId String?      @map("original_owner_membership_id")
  originalOwner             Membership?  @relation("OfferOriginalOwner", fields: [originalOwnerMembershipId], references: [id], onDelete: Restrict)
  createdByMembershipId     String       @map("created_by_membership_id")
  createdBy                 Membership   @relation("OfferCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  expiresAt                 DateTime     @map("expires_at")
  selectedAcceptanceId      String?      @map("selected_acceptance_id")
  resolvedByMembershipId    String?      @map("resolved_by_membership_id")
  resolvedBy                Membership?  @relation("OfferResolver", fields: [resolvedByMembershipId], references: [id], onDelete: Restrict)
  resolvedAt                DateTime?    @map("resolved_at")
  cancelReason              String?      @map("cancel_reason")
  version                   Int          @default(1)
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")
  acceptances               Acceptance[]

  @@index([organizationId, status])
  @@map("offers")
}

model Acceptance {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  offerId           String           @map("offer_id")
  offer             Offer            @relation(fields: [offerId], references: [id], onDelete: Restrict)
  membershipId      String           @map("membership_id")
  membership        Membership       @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  status            AcceptanceStatus
  invalidatedReason Json?            @map("invalidated_reason")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([offerId, membershipId])
  @@map("acceptances")
}

model AuditLog {
  id                BigInt       @id @default(autoincrement())
  organizationId    String       @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorMembershipId String?      @map("actor_membership_id")
  actor             Membership?  @relation(fields: [actorMembershipId], references: [id], onDelete: Restrict)
  action            String
  entityType        String       @map("entity_type")
  entityId          String       @map("entity_id")
  before            Json?
  after             Json?
  metadata          Json?
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
